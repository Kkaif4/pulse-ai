generator client {
  provider        = "prisma-client-js"
  output          = "./generated"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String   @unique @db.VarChar(6)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Trade {
  id        BigInt   @id @default(autoincrement())
  timestamp DateTime @default(now())
  spotPrice Decimal  @map("spot_price") @db.Decimal(10, 2)

  // Core Option Chain Indicators
  pcr             Decimal?  @db.Decimal(4, 2)
  maxPain         Decimal?  @map("max_pain") @db.Decimal(10, 2)
  support         Decimal?  @db.Decimal(10, 2)
  resistance      Decimal?  @db.Decimal(10, 2)
  top3Support     Decimal[] @map("top_3_support") @db.Decimal(10, 2)
  top3Resistance  Decimal[] @map("top_3_resistance") @db.Decimal(10, 2)
  avgIvSkew       Decimal?  @map("avg_iv_skew") @db.Decimal(6, 4)
  atmStrike       Decimal?  @map("atm_strike") @db.Decimal(10, 2)
  atmStraddleCost Decimal?  @map("atm_straddle_cost") @db.Decimal(10, 2)

  // F&O Volumes & OI Changes
  totalCeChgOi BigInt?  @map("total_ce_chg_oi")
  totalPeChgOi BigInt?  @map("total_pe_chg_oi")
  totalCeVol   BigInt?  @map("total_ce_vol")
  totalPeVol   BigInt?  @map("total_pe_vol")
  avgCeAggr    Decimal? @map("avg_ce_aggr") @db.Decimal(10, 2)
  avgPeAggr    Decimal? @map("avg_pe_aggr") @db.Decimal(10, 2)
  foScore      Decimal? @map("fo_score") @db.Decimal(15, 2)

  // Technical Indicators & Trends
  rsi           Decimal? @db.Decimal(5, 2)
  adx           Decimal? @db.Decimal(5, 2)
  spotTrend     String?  @map("spot_trend") @db.VarChar(15)
  emaTrend      String?  @map("ema_trend") @db.VarChar(15)
  longTermTrend String?  @map("long_term_trend") @db.VarChar(15)

  // Conviction Outputs & Signals
  score            Decimal? @db.Decimal(5, 2)
  sentiment        String?  @db.VarChar(30)
  signal           String?  @db.VarChar(50)
  actionableSignal String?  @map("actionable_signal") @db.VarChar(100)
  summary          String?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([timestamp(sort: Desc)], map: "idx_trades_timestamp")
  @@map("trades")
}

model TradeState {
  key   String @id @db.VarChar(50)
  value Json   @db.JsonB

  @@map("trade_state")
}
